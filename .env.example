# Public values — set these in Vercel for Production, Preview, and Development.
NEXT_PUBLIC_SUPABASE_URL=https://wkzneptksvmiifxqyndc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only value — never expose this with a NEXT_PUBLIC_ prefix.
# Use either the current Supabase secret key or the legacy service-role key.
# Required for /admin authorization and every mutation route. There is no anon fallback.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key
